{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OurFoodDb": "Server=127.0.0.1;Port=3306;Database=ourfooddb;Uid=root;Pwd=;"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ourfood-api",
    "Audience": "ourfood-clients",
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "ExpiresMinutes": 120
  },

  "AWS": {
    "Region": "us-east-2",
    "S3": {
      "BucketName": "our-food-bucket"
    }
  }
}
